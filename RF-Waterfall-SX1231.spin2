{Spin2_v51}
#define FNT_POS_NOGRID
#pragma exportdef(FNT_POS_NOGRID)

con

    _clkfreq        = 250_000_000
    _xtlfreq        = 20_000_000


    LABEL_COL       = 0
    DATA_COL        = 12
    RADIO_STACK_SZ  = 42


obj

    ser:    "com.serial.terminal.ansi" | SER_BAUD=2_000_000
    vga:    "display.vga.bitmap-8bpp" | BASEPIN=24, VF=10, VB=33, HF=16, HS=89, HB=85, HV=640
    radio:  "wireless.transceiver.sx1231" | CS=16+0, SCK=16+1, MOSI=16+2, MISO=16+3, RST=16+4, SPI_FREQ=5_000_000
    str:    "string"
    fnt:    "font.5x8"
    wfall:  "metrology.waterfall"


pub main()

    ' 290_000_000..340_000_000, 424_000_000..510_000_000, 862_000_000..1_020_000_000
    rf_config.center_freq := 434_375_000

    setup()
    application()


#include "rf-waterfall-common.spin2"            ' main application code common to all variants


pub radio_setup()
' Radio model-specific setup/initialization

    ' start the driver
    if ( radio.start() )
        ser.strln(@"SX1231 driver started")
    else
        ser.strln(@"SX1231 driver failed to start - halting")
        repeat

    ' set up
    radio.opmode(radio.OPMODE_STDBY)
    radio.rc_osc_cal(TRUE)
    radio.carrier_freq(rf_config.center_freq)
    radio.lna_z_input(50)
    radio.lna_gain(-48)
    radio.rx_bw(2_600)
    radio.rssi_int_thresh(-10)

    radio.rx_mode()

    rf_config.acq_delay := 50
    rf_config.lnagain_idx := 0
    rf_config.dvgagain_idx := 0
    rf_config.rxbw_idx := 23
    rf_config.interm_freq := 0


dat
' Model-specific static data

    ' gain, receive bandwidth LUTs
    '                # values, val0, .., valn
    lna_gains   long 5, -48, -36, -24, -12, -6
    dvga_gains  long 0, 0
    rx_bws      long 24, 500000, 400000, 333300, 250000, 200000, 166700, 125000, 100000, 83300, 62500, 50000, 41700, 31300, 25000, 20800, 15600, 12500, 10400, 7800, 6300, 5200, 3900, 3100, 2600

    ' limits
    rssi_offset byte 115
    if_step     long 0
    if_freq_min long 0
    if_freq_max long 0
    freq_min    long 290_000_000
    freq_max    long 1_020_000_000
    freq_step   long 50_000


dat
