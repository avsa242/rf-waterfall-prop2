{Spin2_v51}
#define FNT_POS_NOGRID
#pragma exportdef(FNT_POS_NOGRID)

con

    _clkfreq        = 250_000_000
    _xtlfreq        = 20_000_000


    LABEL_COL       = 0
    DATA_COL        = 12


obj

    ser:    "com.serial.terminal.ansi" | SER_BAUD=2_000_000
    vga:    "display.vga.bitmap-8bpp" | BASEPIN=24, VF=10, VB=33, HF=16, HS=89, HB=85, HV=640
    radio:  "wireless.transceiver.cc2500" | CS=0+8, SCK=0+9, MOSI=0+11, MISO=0+10, SPI_FREQ=1_000_000
    str:    "string"
    fnt:    "font.5x8"
    wfall:  "metrology.waterfall"


pub main()

    ' 2_400_000..2_483_500 (kHz)
    rf_config.center_freq := 2_400_000

    setup()
    application()


#include "rf-waterfall-common.spin2"            ' main application code common to all variants


pub radio_setup()
' Radio model-specific setup/initialization

    ' start the driver
    if ( radio.start() )
        ser.strln(@"CC2500 driver started")
    else
        ser.strln(@"CC2500 driver failed to start - halting")
        repeat

    ' set up
    radio.gpio0(radio.IO_HI_Z)
    radio.idle()                               ' Change to Idle while changing settings
    radio.auto_cal_mode(radio.IDLE_RXTX)
    radio.carrier_freq(rf_config.start_freq)
    radio.syncwd_mode(radio.SYNCMODE_3032_CS)
    radio.carrier_sense_thresh(14)
    radio.magn_target(24)
    radio.agc_mode(radio.AGC_OFF)
    radio.dc_block_ena(false)
    radio.rx_mode()

    rf_config.acq_delay := 50
    rf_config.lnagain_idx := 7
    rf_config.dvgagain_idx := 3
    rf_config.rxbw_idx := 15
    rf_config.interm_freq := 380_859


dat
' Model-specific static data

    ' gain, receive bandwidth LUTs
    '                # values, val0, .., valn
    lna_gains   long 8, -17, -14, -11, -9, -7, -6, -2, 0
    dvga_gains  long 4, -3, -2, -1, 0
    rx_bws      word 16, 812, 650, 541, 464, 406, 325, 270, 232, 203, 162, 135, 116, 102, 81, 68, 58

    ' limits
    rssi_offset byte 138
    if_step     long 25390
    if_freq_min long 25390
    if_freq_max long 787109
    freq_min    long 2_400_000                  ' kHz
    freq_max    long 2_483_500
    freq_step   long 1_000

dat
